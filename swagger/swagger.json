{
  "openapi": "3.0.0",
  "info": {
    "title": "PostgreSQL Backend API",
    "description": "API documentation for the Drogon backend after user-management routes were unregistered. Authentication is performed with JWT through the Authorization header.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5555",
      "description": "Local server"
    },
    {
      "url": "https://im.uesoft.com",
      "description": "Remote server"
    }
  ],
  "paths": {
    "/api/gitlab/project/invite": {
      "post": {
        "tags": [
          "GitLab"
        ],
        "summary": "邀请用户加入 GitLab 项目",
        "description": "该接口仍保留注册，并通过 JWT 进行鉴权。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userId",
                  "projectId",
                  "accessLevel"
                ],
                "properties": {
                  "userId": {
                    "type": "integer",
                    "description": "用户 ID"
                  },
                  "projectId": {
                    "type": "integer",
                    "description": "GitLab 项目 ID"
                  },
                  "accessLevel": {
                    "type": "integer",
                    "description": "GitLab 访问级别"
                  }
                }
              },
              "example": {
                "userId": 123,
                "projectId": 456,
                "accessLevel": 30
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "examples": {
                  "success": {
                    "value": {
                      "success": true
                    }
                  },
                  "failure": {
                    "value": {
                      "success": false,
                      "message": "用户GitLab信息不存在"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "JWT 无效或过期"
          }
        }
      }
    },
    "/system/ping": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Ping",
        "description": "系统健康检查接口。",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "pong",
                  "data": {
                    "serverTime": 1714348800
                  }
                }
              }
            }
          }
        }
      }
    },
    "/test": {
      "get": {
        "tags": [
          "Test"
        ],
        "summary": "测试接口",
        "description": "开发测试接口。",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/system/sqlite/ping": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "SQLite 健康检查",
        "description": "在默认 SQLite 库上执行 SELECT 1, 用于验证 SQLiteService 是否可用。",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "sqlite ok",
                  "data": {
                    "rowCount": 1,
                    "rows": [
                      { "ok": 1 }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sqlite/query": {
      "post": {
        "tags": ["SQLite"],
        "summary": "参数化查询",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "logicalName": "project.SAM.desi.0001_0001",
                "sql": "SELECT id, name FROM \"users\" WHERE name = ? LIMIT ?",
                "params": [
                  { "type": "text", "value": "alice" },
                  { "type": "int",  "value": 50 }
                ],
                "requestId": "req-2026-06-30-0001",
                "readOnly": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "success",
                  "data": {
                    "rows": [ { "id": 1, "name": "alice" } ],
                    "rowCount": 1,
                    "requestId": "req-2026-06-30-0001"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sqlite/exec": {
      "post": {
        "tags": ["SQLite"],
        "summary": "参数化写操作",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "logicalName": "project.SAM.desi.0001_0001",
                "sql": "UPDATE \"OperInfo\" SET \"User\"=? WHERE \"EnvID\"=? AND \"ElementID\"=?",
                "params": [
                  { "type": "text", "value": "alice" },
                  { "type": "int",  "value": 1024 },
                  { "type": "int",  "value": 33 }
                ],
                "txId": null,
                "requestId": "req-2026-06-30-0002"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "success",
                  "data": {
                    "affectedRows": 1,
                    "ok": true,
                    "requestId": "req-2026-06-30-0002"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sqlite/tx/begin": {
      "post": {
        "tags": ["SQLite"],
        "summary": "开启事务",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "logicalName": "project.SAM.desi.0001_0001" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "success",
                  "data": {
                    "txId": "b39d...ff",
                    "expiresInSec": 60
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sqlite/tx/commit": {
      "post": {
        "tags": ["SQLite"],
        "summary": "提交事务",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "txId": "b39d...ff" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "success",
                  "data": { "txId": "b39d...ff" }
                }
              }
            }
          }
        }
      }
    },
    "/api/sqlite/tx/rollback": {
      "post": {
        "tags": ["SQLite"],
        "summary": "回滚事务",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "txId": "b39d...ff" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "success",
                  "data": { "txId": "b39d...ff" }
                }
              }
            }
          }
        }
      }
    },
    "/api/sqlite/resolve": {
      "post": {
        "tags": ["SQLite"],
        "summary": "解析逻辑数据库标识",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "scope": "project",
                "projectCode": "SAM",
                "templateKind": "desi",
                "fileName": "0001_0001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "success",
                  "data": {
                    "logicalName": "project.SAM.desi.0001_0001"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
